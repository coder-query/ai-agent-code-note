   "source": [
    "# np.any()\t至少有一个元素满足指定条件，就返回True\n",
    "# np.all()\t所有的元素都满足指定条件，才返回True\n",
    "import numpy as np\n",
    "arr1 = np.array([1, 2, 3, 4, 5])\n",
    "print(np.any(arr1 > 3))\n",
    "print(np.all(arr1 > 3))"
   ],

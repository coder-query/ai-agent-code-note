   "cell_type": "code",
   "source": [
    "import numpy as np\n",
    "ndarray = np.array([[1, 2, 3], [4, 5, 6]]) # 创建一个二维数组\n",
    "ndarray\n",
    "print(ndarray.ndim) # 维度\n",
    "print(ndarray.shape) # 形状\n",
    "print(ndarray.size) # 元素个数\n",
    "print(ndarray.dtype) # 数据类型\n",
    "print(ndarray.itemsize) # 每个元素字节数大小"
   ],

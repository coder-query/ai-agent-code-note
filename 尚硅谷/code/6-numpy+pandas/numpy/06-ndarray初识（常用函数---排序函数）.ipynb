    "# ndarray.sort()：就地排序（直接修改原数组）。\n",
    "import numpy as np\n",
    "arr1 = np.random.randint(0, 10, (3, 3))\n",
    "print(arr1)\n",
    "arr1.sort()\n",
    "print(arr1)\n",
    "arr1.sort(axis=0)\n",
    "print(arr1)"
